{
  "name": "nysc-gps",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/ws/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }]
}
